# Copy to .env for local runs:  cp .env.example .env
# In GitHub Actions these come from repo SECRETS, never from a committed file.

# Discord webhook that receives the posts
DISCORD_WEBHOOK_URL=https://discord.com/api/....

# Instagram usernames to watch, comma-separated (spaces around commas are ok)
ACCOUNTS=acc1,aac2,..

# Optional tuning (defaults shown)
#BATCH_SIZE=6
#ACCOUNT_DELAY=8000
#SEED_ONLY=0
